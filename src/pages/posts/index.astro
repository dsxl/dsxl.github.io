---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base title="Writing" description="Essays and notes by Dimitriy Shames.">
  <section>
    <div class="wrap">
      <h1>Writing</h1>
      <p class="lede">Occasional notes. Mostly about systems, sometimes not.</p>

      <div class="cards" style="margin-top:2.5rem">
        {posts.map((post) => (
          <a class="card" href={`/posts/${post.id}/`}>
            <span class="role-when">{fmt(post.data.date)}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
